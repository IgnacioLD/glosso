    <string name="settings_server_default">डिफ़ॉल्ट: %1$s</string>
    <string name="server_title">सर्वर</string>
    <string name="server_intro">Glosso फ़्री सॉफ़्टवेयर है और कोई भी इसका सर्वर चला सकता है। किसी भरोसेमंद Glosso सर्वर का पता डालें, जैसे वह जिसे आप ख़ुद होस्ट करते हैं। इसके बाद लेसन, क्लाउड स्कोरिंग और डाउनलोड उसी सर्वर से आएँगे।</string>
