<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follow the system theme: paper during the day, ink at night. The
         background is set from the first frame so there is no white flash. -->
    <style name="Theme.Glosso" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/glosso_color_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
