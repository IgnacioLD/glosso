# Glosso Pro - environment template.
#
# Copy to .env and fill in real values. NEVER commit the real .env.
#   cp .env.example .env
# The .env file is gitignored (.gitignore: .env / .env.*). On the VPS it can
# live under /srv/glosso/secrets/ with 600 permissions.
#
# The values here are placeholders: deploy.sh generates GLOSSO_DB_PASSWORD and
# GLOSSO_ADMIN_TOKEN randomly if it creates .env from scratch.

# ---- Dominio y TLS ---------------------------------------------------------
# Dominio publico de la API. Caddy pide el certificado Let's Encrypt para el.
# El DNS debe apuntar ya al VPS antes del primer arranque.
GLOSSO_DOMAIN=api.glossopro.example
# Subdominios que sirve Caddy. El DNS es el comodin *.glossostudio.com. Vacio =
# Caddy usa el default del Caddyfile (umami/status .glossostudio.com).
GLOSSO_UMAMI_DOMAIN=
GLOSSO_STATUS_DOMAIN=

# ---- Rutas en el host ------------------------------------------------------
# Assets existentes (modelo, vocab, content/<code>/...). Se montan read-only.
GLOSSO_ASSETS_DIR=/srv/glosso/assets
# Datos persistentes (postgres, redis, prometheus, uptime-kuma, backups).
GLOSSO_DATA_DIR=/srv/glosso/data
# Secretos fuera de git (p.ej. el token de scrape de Prometheus), permisos 600.
GLOSSO_SECRETS_DIR=/srv/glosso/secrets
# Registro de voces de referencia (POST /v1/admin/voices): registry.json +
# <uuid>.<ext>. Se monta ESCRIBIBLE en el contenedor (/voices via
# GLOSSO_VOICES_DIR) porque /assets es de solo lectura. Debe ser un directorio
# persistente y propiedad del uid del contenedor (10001:10001); deploy.sh lo
# crea asi. Para cambiarlo, apunta aqui otra ruta del host y vuelve a desplegar.
# Ver docs/MULTI-ACCENT.md y docs/SERVIDOR-ESCRITURA-MINIMA.md.
GLOSSO_VOICES_HOST_DIR=/srv/glosso/voices

# ---- Modelo de scoring -----------------------------------------------------
# Artefacto ONNX que carga el servidor desde GLOSSO_ASSETS_DIR. El vocabulario
# (phoneme_vocab.json) es comun a todas las variantes. Por defecto, nuestro int8
# selectivo de ~342 MB (~509 MB RSS frente a ~2185 MB del fp16): el mismo
# artefacto que descarga la app, para que la nota coincida en nube y dispositivo.
# Ver docs/INFRASTRUCTURE.md y benchmark/finetune/QUANT-REPORT.md.
GLOSSO_MODEL_FILE=wav2vec2_phoneme_int8_dyn_pertensor.onnx

# ---- PostgreSQL ------------------------------------------------------------
# Nombre y usuario de la base. El puerto 5432 nunca se publica.
GLOSSO_DB_NAME=glosso
GLOSSO_DB_USER=glosso
# OBLIGATORIO. Sin esto Compose no arranca. Usar una cadena larga y aleatoria.
GLOSSO_DB_PASSWORD=CHANGE_ME_postgres_password
# Conexion JDBC que usa el servidor (analytics + plano de control + TTS).
GLOSSO_DB_URL=jdbc:postgresql://postgres:5432/glosso
# Retencion de eventos de analitica (dias).
GLOSSO_ANALYTICS_RETENTION_DAYS=180

# ---- Umami (analitica web) -------------------------------------------------
# Corre en el mismo PostgreSQL pero con base y usuario DEDICADOS (no los de
# glosso). El password viaja dentro de DATABASE_URL: generarlo en hex para no
# romper la URL. Sin password ni APP_SECRET, Compose no arranca. Comandos de
# alta, secreto sin historial y rollback en docs/INFRA-DEPLOY.md.
GLOSSO_UMAMI_DB_NAME=
GLOSSO_UMAMI_DB_USER=
GLOSSO_UMAMI_DB_PASSWORD=
# Secreto de sesion de umami (firma las cookies); largo y aleatorio.
GLOSSO_UMAMI_APP_SECRET=

# ---- API -------------------------------------------------------------------
# Puerto HTTP interno del servidor.
PORT=8080
# Token que protege /metrics, /stats y las vistas admin. OBLIGATORIO.
GLOSSO_ADMIN_TOKEN=CHANGE_ME_admin_token
# Credencial X-Api-Key de /v1/score. Dejar vacio hasta que la app la envie.
GLOSSO_API_KEY=
# Token de servicio de POST /v1/profiles/sync (cabecera X-Ingest-Token). Fail
# closed: si se deja vacio, la ingesta responde 401 y queda deshabilitada. Es la
# unica via que puede disparar coste TTS, asi que definir una cadena aleatoria
# larga (nunca un valor por defecto conocido). Lo fija el despliegue (deployall).
GLOSSO_INGEST_TOKEN=
# 1 = descarga modelo/vocab/CMUdict en el primer arranque (si no hay assets).
GLOSSO_BOOTSTRAP=
# Integridad de los assets (A08). Ruta a un fichero formato sha256sum
# ("<hex>  <fichero>" por linea). Si se define, cada asset descargado o ya
# presente se verifica y un fallo es fatal; si el fichero no existe, el arranque
# falla (fail closed). Vacio = sin verificacion (solo el minimo de tamano).
GLOSSO_ASSET_CHECKSUMS=
# Reconocimientos simultaneos (2 vCPU: no subir de 1-2).
GLOSSO_MAX_CONCURRENT=1
# Espera maxima en cola antes de devolver 503 (ms).
GLOSSO_QUEUE_WAIT_MS=30000
# 1 = logs del engine (fonemas). Dejar vacio en produccion.
GLOSSO_DEBUG=
# Origenes CORS permitidos para web, separados por coma. Vacio = sin CORS.
# Solo origenes explicitos y solo los necesarios (nunca *). La web y la demo
# viven en glossostudio.com, asi que el valor de produccion es ese (o los dos
# hostnames si www tambien llama a la API).
GLOSSO_CORS_ORIGINS=https://glossostudio.com
# Heap de la JVM del API. Deja margen en una maquina de 7,8 GB compartida.
GLOSSO_JAVA_OPTS="-Xms128m -Xmx1536m"

# ---- Billing Play (docs/BILLING-E2E.md) ------------------------------------
# JSON de la cuenta de servicio en base64 (en Docker es lo mas practico).
GLOSSO_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
# Paquete y producto que se validan en Play.
GLOSSO_PLAY_PACKAGE=me.shirobyte42.glosso
GLOSSO_PLAY_PRODUCT_ID=me.shirobyte42.glosso.pro
# Id de la oferta de prueba (vacio = se reporta ACTIVE).
GLOSSO_PLAY_TRIAL_OFFER_ID=
# TTL de la cache de verificaciones de compra (segundos, 0 = sin cache).
GLOSSO_BILLING_CACHE_TTL_SECONDS=600
# Secreto compartido que Pub/Sub presenta en /v1/billing/rtdn.
GLOSSO_RTDN_SECRET=
# Subscription push esperada; si se define, se comprueba el sobre.
GLOSSO_RTDN_SUBSCRIPTION=

# ---- Plano de generacion (fase 2+) -----------------------------------------
# El worker y el scheduler viven en el mismo proceso que la API (un solo
# worker, stateless). Ver docs/CONTENT_POOL.md.
# Ruta al providers.yaml del Provider Router.
GLOSSO_PROVIDER_CONFIG=/etc/glosso/providers.yaml
# Periodicidad del scheduler (horas).
GLOSSO_SCHEDULE_HOURS=6
# Tamano del pool de contenido por need class (min/target/max).
GLOSSO_POOL_MIN=20
GLOSSO_POOL_TARGET=50
GLOSSO_POOL_MAX=100
# Caps de coste por job y por batch (vacio = sin cap explicito).
GLOSSO_MAX_COST_PER_JOB=
GLOSSO_MAX_COST_PER_BATCH=

# ---- Cola Redis (fase 2) ---------------------------------------------------
# Si no se define, la generacion se desactiva limpiamente y la API sigue igual.
# Formato: redis://[usuario:password@]host:puerto[/db] (o rediss:// para TLS).
GLOSSO_REDIS_URL=redis://redis:6379
# Nombre del consumidor dentro del grupo workers-tts.
GLOSSO_WORKER_ID=worker-1
# Reintentos del worker antes de mandar el job a la DLQ y marcarlo DEAD.
GLOSSO_GENERATION_MAX_ATTEMPTS=3
# Backoff base de reintento (ms): el intento N espera N * esto.
GLOSSO_GENERATION_RETRY_BACKOFF_MS=30000
# Mensajes por corrida del worker y clases por ciclo del scheduler.
GLOSSO_GENERATION_MAX_MESSAGES=50
GLOSSO_GENERATION_MAX_CLASSES=50
# Bloqueo del worker cuando la cola esta vacia (ms).
GLOSSO_GENERATION_WORKER_BLOCK_MS=1000

# ---------------------------------------------------------------------------
# Decoupled TTS layer. See docs/TTS-LAYER.md and docs/TTS-LAYER-BRIEF.md.
# ---------------------------------------------------------------------------

# Which provider generates audio first: cartesia | elevenlabs.
TTS_PROVIDER=cartesia

# Optional comma-separated fallback chain, used ONLY for transient errors
# (timeout, HTTP 429, HTTP 5xx). Empty means no fallback.
# ElevenLabs is prepared but not activated in production yet.
TTS_FALLBACK_PROVIDERS=

# Worker limits.
TTS_MAX_CONCURRENCY=2
TTS_MAX_RETRIES=2
TTS_TIMEOUT_SECONDS=30

# Audio format and the slow variant speed (part of the cache fingerprint).
TTS_OUTPUT_FORMAT=mp3
TTS_OUTPUT_SAMPLE_RATE=44100
TTS_OUTPUT_BIT_RATE=128000
TTS_SLOW_SPEED=0.7

# Object storage cache prefix and optional local cache directory. The cache dir
# is shared with tools/content/pipeline.py.
TTS_CACHE_PREFIX=tts
GLOSSO_TTS_CACHE_DIR=/srv/glosso/tts-cache

# Voice palette. Small and deliberate, never a voice per item:
#   - TTS_VOICE_DEFAULT is the single voice for vocabulary and drills. Empty
#     falls back to CARTESIA_DEFAULT_VOICE.
#   - TTS_DIALOGUE_VOICES is an ordered list for dialogue speakers, so a
#     dialogue sounds like different people. The content picks a speaker index;
#     the voice is deterministic, never random.
#   - A piece of content may also request a concrete voice per request.
# Changing a voice changes the cache fingerprint, so the old audio is not reused
# (correct: it is different audio).
TTS_VOICE_DEFAULT=
TTS_DIALOGUE_VOICES=b24f41fd-00a3-4cd8-992a-a0c9f13f3ef1,c46cf1f6-49a1-4d67-9a57-ff859a4046d3

# Cartesia (primary). The key never goes to Git or to the Android client.
# The key is exchanged for an access token (grant "tts"); the API key itself is
# NOT sent to /tts/bytes. CARTESIA_VERSION is the required API version.
# GB voices supplied by the owner (public ids, not secrets):
#   male:   b24f41fd-00a3-4cd8-992a-a0c9f13f3ef1, 5568a7df-e5ab-4442-9fae-2e9ba1b15ad8
#   female: c46cf1f6-49a1-4d67-9a57-ff859a4046d3, 273f9ef7-9fc2-4def-88bb-ab108c6249ca
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
CARTESIA_DEFAULT_VOICE=b24f41fd-00a3-4cd8-992a-a0c9f13f3ef1
CARTESIA_BASE_URL=https://api.cartesia.ai
CARTESIA_VERSION=2026-08-14

# Cartesia auth is two-step: the API key is exchanged for a short-lived JWT via
# POST /access-token, and only that JWT is sent to /tts/bytes (the API key is
# rejected there with 401). The JWT is cached until shortly before it expires.
#   - CARTESIA_TOKEN_GRANTS: comma-separated grants to request. Keep it to what
#     is used; `tts` is enough today.
#   - CARTESIA_TOKEN_EXPIRES_IN: requested token lifetime in seconds.
#   - CARTESIA_TOKEN_REFRESH_SKEW_SECONDS: refresh this many seconds before expiry.
#   - CARTESIA_TOKEN_VERSION: version header for the token endpoint (defaults to
#     CARTESIA_VERSION).
CARTESIA_TOKEN_GRANTS=tts
CARTESIA_TOKEN_EXPIRES_IN=120
CARTESIA_TOKEN_REFRESH_SKEW_SECONDS=30
CARTESIA_TOKEN_VERSION=2026-08-14

# ElevenLabs (secondary, off by default). Its voice ids are different from
# Cartesia's, so leave it empty until a real ElevenLabs voice is chosen.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Estimated cost per 1,000,000 characters. Set from your current plan; unset
# means the estimate is 0 while the character count is still recorded.
TTS_COST_PER_1M_CHARS_CARTESIA=
TTS_COST_PER_1M_CHARS_ELEVENLABS=

# ---- Object storage (Cloudflare R2) ----------------------------------------
# Endpoint S3-compatible. If unset, GLOSSO_TTS_CACHE_DIR is used, and if that is
# also unset an in-memory store is used (not durable).
GLOSSO_R2_ENDPOINT=
GLOSSO_R2_BUCKET=
GLOSSO_R2_ACCESS_KEY=
GLOSSO_R2_SECRET_KEY=
GLOSSO_R2_REGION=auto
GLOSSO_R2_PATH_STYLE=true

# ---- Backups ---------------------------------------------------------------
# Retencion GFS de dumps locales.
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_MONTHLY_KEEP=6
# Subida opcional a R2 (requiere el CLI `aws` en el host). Vacio = solo local.
# La politica de lifecycle del bucket se documenta en docs/INFRA-DEPLOY.md.
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
