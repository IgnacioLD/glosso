#!/usr/bin/env bash
#
# glosso-secret - acceso a claves para agentes sin imprimir el valor.
#
# Almacen principal: llavero de macOS (servicio "glosso-secret").
# Respaldo de lectura: $GLOSSO_KEYS_DIR (por defecto ~/glosso-keys) en formato
# .env, para no romper el flujo actual durante la migracion.
#
# El valor nunca se escribe en la linea de comandos del proceso llamante ni en
# stdout: se inyecta en el entorno del hijo (`run`) o en un fichero 600 (`@`).
#
# Uso: glosso-secret help
#
set -euo pipefail

SERVICE="glosso-secret"
KEYS_DIR="${GLOSSO_KEYS_DIR:-$HOME/glosso-keys}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/glosso"
INDEX="${GLOSSO_KEYS_INDEX:-$CONFIG_DIR/secret-index.txt}"
TMPFILES=()

die() { printf 'glosso-secret: %s\n' "$*" >&2; exit 1; }
note() { printf 'glosso-secret: %s\n' "$*" >&2; }

have_keychain() { command -v security >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
glosso-secret - claves para agentes sin imprimir valores

  list                      Nombres disponibles (nunca valores).
  which NAME                De donde sale NAME: keychain | file | not-found.
  run [NAME[=ENVVAR]]... -- COMANDO [ARGS...]
                            Ejecuta COMANDO con cada NAME resuelto en el
                            entorno. NAME solo -> variable NAME. NAME=ENVVAR ->
                            variable ENVVAR. NAME@ENVVAR -> fichero 600 temporal
                            con el valor, y la variable apunta a su ruta.
  file NAME [--out RUTA]    Escribe el valor a un fichero 600 y muestra la
                            RUTA (no el valor). Pensado para herramientas que
                            piden una ruta.
  set NAME                  Lee el valor de stdin y lo guarda en el llavero.
                            Sin eco si hay terminal.
  import [DIR]              Importa NAME=valor de DIR/*.env al llavero.
                            Por defecto DIR=$GLOSSO_KEYS_DIR. No borra ficheros.
  rm NAME                   Borra NAME del llavero (no toca los ficheros).

Variables: GLOSSO_KEYS_DIR, GLOSSO_KEYS_INDEX.
EOF
}

index_add() {
  mkdir -p "$(dirname "$INDEX")"
  [ -f "$INDEX" ] || : > "$INDEX"
  chmod 600 "$INDEX"
  grep -qxF "$1" "$INDEX" || printf '%s\n' "$1" >> "$INDEX"
}

index_remove() {
  [ -f "$INDEX" ] || return 0
  grep -vxF "$1" "$INDEX" > "$INDEX.tmp" || true
  mv "$INDEX.tmp" "$INDEX"
}

# resuelve NAME imprimiendo el valor por stdout (uso interno, se captura)
resolve() {
  local name="$1" val=""
  if have_keychain && val=$(security find-generic-password -a "$name" -s "$SERVICE" -w 2>/dev/null); then
    printf '%s' "$val"
    return 0
  fi
  if [ -d "$KEYS_DIR" ]; then
    local f line
    for f in "$KEYS_DIR"/*.env; do
      [ -e "$f" ] || continue
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in "$name"=*) printf '%s' "${line#*=}"; return 0 ;; esac
      done < "$f"
    done
  fi
  die "no encuentro la clave '${name}' (ni en el llavero '${SERVICE}' ni en ${KEYS_DIR})"
}

cmd_list() {
  {
    [ -f "$INDEX" ] && cat "$INDEX"
    if [ -d "$KEYS_DIR" ]; then
      grep -h -o '^[A-Za-z_][A-Za-z0-9_]*=' "$KEYS_DIR"/*.env 2>/dev/null | sed 's/=$//'
    fi
  } | grep -v '^$' | sort -u
}

cmd_which() {
  local name="${1:?falta NAME}"
  if have_keychain && security find-generic-password -a "$name" -s "$SERVICE" -w >/dev/null 2>&1; then
    printf 'keychain\n'
    return 0
  fi
  if [ -d "$KEYS_DIR" ] && grep -qs "^${name}=" "$KEYS_DIR"/*.env 2>/dev/null; then
    printf 'file:%s\n' "$KEYS_DIR"
    return 0
  fi
  printf 'not-found\n'
  return 1
}

cmd_run() {
  local -a assigns=()
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do assigns+=("$1"); shift; done
  [ "${1:-}" = "--" ] || die "falta '--' antes del comando"
  shift
  [ "$#" -gt 0 ] || die "falta el comando a ejecutar"

  local spec name envname value tmp
  for spec in "${assigns[@]}"; do
    case "$spec" in
      *@*)
        name="${spec%@*}"; envname="${spec#*@}"
        tmp="$(mktemp "${TMPDIR:-/tmp}/glosso-secret.XXXXXX")"
        chmod 600 "$tmp"
        resolve "$name" > "$tmp"
        TMPFILES+=("$tmp")
        export "$envname=$tmp"
        ;;
      *=*)
        name="${spec%%=*}"; envname="${spec#*=}"
        value="$(resolve "$name")"
        export "$envname=$value"
        ;;
      *)
        name="$spec"; envname="$spec"
        value="$(resolve "$name")"
        export "$envname=$value"
        ;;
    esac
  done

  "$@"
}

cleanup_tmpfiles() { local t; for t in ${TMPFILES[@]+"${TMPFILES[@]}"}; do rm -f "$t"; done; }

cmd_file() {
  local name="${1:?falta NAME}"; shift || true
  local out=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --out) out="${2:?falta ruta tras --out}"; shift 2 ;;
      *) die "opcion desconocida: $1" ;;
    esac
  done
  umask 077
  if [ -z "$out" ]; then
    out="$(mktemp "${TMPDIR:-/tmp}/glosso-secret.XXXXXX")"
  else
    mkdir -p "$(dirname "$out")"
    [ -e "$out" ] && rm -f "$out"
  fi
  resolve "$name" > "$out"
  chmod 600 "$out"
  printf '%s\n' "$out"
}

cmd_set() {
  local name="${1:?falta NAME}"
  have_keychain || die "no hay 'security'; en este SO usa los ficheros de ${KEYS_DIR}"
  local value=""
  if [ -t 0 ]; then
    printf 'Valor para %s (no se muestra): ' "$name" >&2
    IFS= read -rs value; printf '\n' >&2
  else
    value="$(cat)"
  fi
  [ -n "$value" ] || die "valor vacio"
  # The keychain hands a multi-line value back hex-encoded, so only one line is
  # stored. A JSON document (a service account key) is compacted to one line.
  case "$value" in
    *$'\n'*)
      value="$(printf '%s' "$value" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin), separators=(",", ":")))' 2>/dev/null)" \
        || die "valor de varias lineas que no es JSON: guardalo en una sola linea"
      ;;
  esac
  security add-generic-password -a "$name" -s "$SERVICE" -w "$value" -U -T /usr/bin/security >/dev/null
  index_add "$name"
  note "guardado ${name} en el llavero"
}

cmd_import() {
  local dir="${1:-$KEYS_DIR}"
  have_keychain || die "no hay 'security'; no hay llavero donde importar"
  [ -d "$dir" ] || die "no existe ${dir}"
  local f line name value n=0
  for f in "$dir"/*.env; do
    [ -e "$f" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|\#*) continue ;; esac
      case "$line" in *=*) ;; *) continue ;; esac
      name="${line%%=*}"; value="${line#*=}"
      case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
      [ -n "$value" ] || continue
      security add-generic-password -a "$name" -s "$SERVICE" -w "$value" -U -T /usr/bin/security >/dev/null
      index_add "$name"
      n=$((n + 1))
    done < "$f"
  done
  note "importadas ${n} claves al llavero '${SERVICE}' (los ficheros no se han tocado)"
}

cmd_rm() {
  local name="${1:?falta NAME}"
  have_keychain || die "no hay 'security'"
  security delete-generic-password -a "$name" -s "$SERVICE" >/dev/null 2>&1 || true
  index_remove "$name"
  note "borrado ${name} del llavero (los ficheros, si existen, siguen)"
}

main() {
  trap cleanup_tmpfiles EXIT
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list) cmd_list ;;
    which) cmd_which "$@" ;;
    run) cmd_run "$@" ;;
    file) cmd_file "$@" ;;
    set) cmd_set "$@" ;;
    import) cmd_import "$@" ;;
    rm) cmd_rm "$@" ;;
    help|-h|--help) usage ;;
    *) die "comando desconocido: ${cmd} (prueba 'glosso-secret help')" ;;
  esac
}

main "$@"
